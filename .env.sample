## Couchbase connection
COUCHBASE_CONNSTR=couchbase://connectionString
COUCHBASE_USERNAME=username
COUCHBASE_PASSWORD=password
COUCHBASE_BUCKET=email
# Optional: specify scope and collection
# COUCHBASE_SCOPE=myscope
# COUCHBASE_COLLECTION=mycollection

## Embedding provider: OpenAI (preferred) or local sentence-transformers
# To use OpenAI embeddings, set OPENAI_API_KEY and optionally model
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# If you prefer local embeddings, optionally set a model name for sentence-transformers
# SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
# CUDA_VISIBLE_DEVICES=